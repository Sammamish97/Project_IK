#: /Game/StringTables/ActiveSkill/ActiveSkill_detail.ActiveSkill_detail
msgctxt "ActiveSkill_Detail,DS_A"
msgid "{0}의 체력과 {1}의 공격력을 가진 포탑을 소환합니다. 20%의 추가 공격속도를 얻습니다."
msgstr "Summons a turret with {0} HP and {1} attack power. Gain an additional 20% attack speed."

#. Key:	DS_B
#. SourceLocation:	/Game/StringTables/ActiveSkill/ActiveSkill_detail.ActiveSkill_detail
#: /Game/StringTables/ActiveSkill/ActiveSkill_detail.ActiveSkill_detail
msgctxt "ActiveSkill_Detail,DS_B"
msgid "{0}의 체력과 {1}의 공격력을 가진 포탑을 소환합니다."
msgstr "Summons a turret with {0} HP and {1} attack power."

#. Key:	EC_A
